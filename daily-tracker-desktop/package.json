{
  "name": "daily-tracker-desktop",
  "version": "1.0.0",
  "description": "Daily Tracker desktop app — a dedicated window onto the web app with a tray icon and native notifications.",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64"
  },
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.artechsolution.dailytracker",
    "productName": "DailyTracker",
    "files": ["main.js", "preload.js", "build/icon.*"],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "DailyTracker-Setup.exe",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Daily Tracker"
    }
  }
}
